      0
     ]
    },
    {
     "type": "point",
     "id": "B"
    },
    {
     "type": "point",
     "id": "C"
    },
    {
     "type": "point",
     "id": "D"
    },
    {
     "type": "point",
     "id": "F"
    },
    {
     "type": "point",
     "id": "G"
    },
