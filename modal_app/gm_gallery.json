[{"topic":"adding up the numbers in an array with a loop","tags":"algorithm array loop index pointer running total programming","ir":{"title":"Summing an array","vars":{"i":0,"total":0},"objects":[{"type":"cells","id":"arr","values":[4,7,1,8,3]},{"type":"pointer","id":"ptr","at":"arr[{i}]","text":"i = {i}"},{"type":"readout","id":"ro","text":"total = {total}"}],"checks":[["eq","4+7+1+8+3","23"]],"beats":[{"say":"Start with a total of zero at the first cell.","do":[["show","arr","ptr","ro"]]},{"say":"Add the cell, then move one to the right.","do":[["highlight","arr[0]"],["set",{"total":"total+4"}],["set",{"i":"i+1"}],["highlight","arr[1]"],["set",{"total":"total+7"}],["set",{"i":"i+1"}]]},{"say":"Keep going to the end.","do":[["set",{"total":"total+1","i":"i+1"}],["set",{"total":"total+8","i":"i+1"}],["set",{"total":"total+3"}],["color","arr[0:5]","good"]]},{"say":"The total is twenty three.","do":[["highlight","ro"]]}]}},{"topic":"energy flow in a food chain","tags":"biology ecology process flow diagram energy chain sequence","ir":{"title":"Energy in a food chain","vars":{"E0":10000,"eff":0.1,"E1":"E0*eff","E2":"E1*eff","E3":"E2*eff"},"objects":[{"type":"icon","id":"sun","icon":"sun","size":1.1},{"type":"box","id":"grass","text":"Grass","color":"good"},{"type":"box","id":"rabbit","text":"Rabbit","color":"b"},{"type":"box","id":"fox","text":"Fox","color":"d"},{"type":"flow","id":"f0","from":"sun","to":"grass","color":"accent"},{"type":"flow","id":"f1","from":"grass","to":"rabbit","label":"10%"},{"type":"flow","id":"f2","from":"rabbit","to":"fox","label":"10%"},{"type":"label","id":"lg","for":"grass","text":"{E1:.0f} kJ","side":"below","color":"muted"},{"type":"label","id":"lr","for":"rabbit","text":"{E2:.0f} kJ","side":"below","color":"muted"},{"type":"label","id":"lf","for":"fox","text":"{E3:.0f} kJ","side":"below","color":"muted"}],"constraints":[["row",["sun","grass","rabbit","fox"],1.3]],"checks":[["eq","E3","E0*eff**3"]],"beats":[{"say":"Energy enters the chain from the sun.","do":[["show","sun","grass","f0"],["flow","f0",{"color":"accent"}],["show","lg"]]},{"say":"Each step passes on only about a tenth of the energy.","do":[["show","rabbit","f1","lr"],["flow","f1"]]},{"say":"So the fox at the top gets very little.","do":[["show","fox","f2","lf"],["flow","f2"],["highlight","lf"]]}]}},{"topic":"isosceles triangle base angles are equal","tags":"geometry triangle angle proof equal sides symmetry","ir":{"title":"Isosceles triangle base angles","vars":{"side":3.2,"apex":"40*deg","base_angle":"(pi-apex)/2"},"objects":[{"type":"point","id":"A","at":[0,0],"label":"A"},{"type":"point","id":"B","label":"B"},{"type":"point","id":"C","label":"C"},{"type":"point","id":"M"},{"type":"polygon","id":"tri","points":["A","B","C"],"color":"a","fill":0.15},{"type":"segment","id":"AM","from":"A","to":"M","dashed":true,"color":"muted"},{"type":"angle","id":"angB","points":["A","B","C"],"color":"b","label":"{base_angle/deg:.0f}\u00b0"},{"type":"angle","id":"angC","points":["A","C","B"],"color":"b","label":"{base_angle/deg:.0f}\u00b0"},{"type":"angle","id":"angM","points":["A","M","B"],"color":"muted"},{"type":"readout","id":"ro","text":"apex {apex/deg:.0f}\u00b0   each base angle {base_angle/deg:.0f}\u00b0"}],"constraints":[["distance","A","B","side"],["distance","A","C","side"],["angle","B","A","C","apex"],["horizontal","B","C"],["below","B","A",0.1],["left_of","B","C",0.1],["midpoint","M","B","C"]],"checks":[["eq","angle(A,B,C)","angle(A,C,B)"],["eq","angle(A,B,C)+angle(B,C,A)+angle(C,A,B)","pi"]],"beats":[{"say":"Two sides of this triangle are equal.","do":[["show","tri","A","B","C"]]},{"say":"Fold it along the line from the top to the middle of the base.","do":[["show","AM","angM"],["highlight","AM"]]},{"say":"The two halves match, so the base angles are equal.","do":[["show","angB","angC","ro"]]},{"say":"Change the top angle and they stay equal.","do":[["animate","apex","80*deg",{"run":3}],["animate","apex","40*deg",{"run":2}]]}]}},{"topic":"slope of a straight line y = m x + c","tags":"algebra graph linear function gradient slope intercept axes","ir":{"title":"Slope of a line","vars":{"m":0.5,"c":1,"x1":1,"x2":3,"y1":"m*x1+c","y2":"m*x2+c"},"objects":[{"type":"axes","id":"ax","x":[-1,5],"y":[-1,5],"unit":[0.9,0.9],"x_label":"x","y_label":"y"},{"type":"function","id":"line","on":"ax","expr":"m*x+c","color":"a","tex_label":"y = mx + c"},{"type":"point","id":"P","on":"ax","at":["x1","y1"],"color":"b"},{"type":"point","id":"Q","on":"ax","at":["x2","y2"],"color":"b"},{"type":"point","id":"K","on":"ax","at":["x2","y1"]},{"type":"segment","id":"run","from":"P","to":"K","color":"muted","dashed":true,"label":"run 2"},{"type":"segment","id":"rise","from":"K","to":"Q","color":"b","label":"rise {y2-y1:.1f}"},{"type":"readout","id":"ro","text":"slope m = rise / run = {(y2-y1)/(x2-x1):.2f}"}],"checks":[["eq","(y2-y1)/(x2-x1)","m"]],"beats":[{"say":"Here is the line y equals m x plus c.","do":[["show","ax","line"]]},{"say":"Step two to the right along the line, and see how far it rises.","do":[["show","P","Q","run","rise"],["show","ro"]]},{"say":"Rise over run is the slope; make the line steeper and it grows.","do":[["animate","m",1.5,{"run":3}]]}]}}]