    {
     "say": "Each step passes on only about a tenth of the energy.",
     "do": [
      [
       "show",
       "rabbit",
       "f1",
       "lr"
      ],
      [
       "flow",
       "f1"
      ]
     ]
    },
    {
     "say": "So the fox at the top gets very little.",
     "do": [
      [
       "show",
       "fox",
       "f2",
       "lf"
      ],
      [
       "flow",
       "f2"
      ],
      [
       "highlight",
       "lf"
      ]
     ]
    }
   ]
  }
 },
 {
  "topic": "isosceles triangle base angles are equal",
  "tags": "geometry triangle angle proof equal sides symmetry",
  "ir": {
   "title": "Isosceles triangle base angles",
   "vars": {
    "side": 3.2,
    "apex": "40*deg",
    "base_angle": "(pi-apex)/2"
   },
   "objects": [
    {
     "type": "point",
     "id": "A",
     "at": [
      0,
      0
     ],
     "label": "A"
    },
    {
     "type": "point",
     "id": "B",
     "label": "B"
    },
    {
     "type": "point",
     "id": "C",
     "label": "C"
    },
    {
     "type": "point",
     "id": "M"
    },
    {
     "type": "polygon",
     "id": "tri",
     "points": [
      "A",
      "B",
      "C"
     ],
     "color": "a",
     "fill": 0.15
    },
    {
     "type": "segment",
     "id": "AM",
     "from": "A",
     "to": "M",
     "dashed": true,
     "color": "muted"
    },
    {
     "type": "angle",
     "id": "angB",
     "points": [
      "A",
      "B",
      "C"
     ],
     "color": "b",
     "label": "{base_angle/deg:.0f}\u00b0"
    },
    {
     "type": "angle",
     "id": "angC",
     "points": [
      "A",
      "C",
      "B"
     ],
     "color": "b",
     "label": "{base_angle/deg:.0f}\u00b0"
    },
    {
     "type": "angle",
     "id": "angM",
     "points": [
      "A",
      "M",
      "B"
     ],
     "color": "muted"
    },
    {
     "type": "readout",
     "id": "ro",
     "text": "apex {apex/deg:.0f}\u00b0   each base angle {base_angle/deg:.0f}\u00b0"
    }
   ],
   "constraints": [
    [
     "distance",
     "A",
     "B",
     "side"
    ],
    [
     "distance",
     "A",
     "C",
     "side"
    ],
    [
     "angle",
     "B",
     "A",
     "C",
     "apex"
    ],
    [
     "horizontal",
     "B",
     "C"
    ],
    [
     "below",
     "B",
     "A",
     0.1
    ],
    [
     "left_of",
     "B",
     "C",
     0.1
    ],
    [
     "midpoint",
     "M",
     "B",
     "C"
    ]
   ],
   "checks": [
    [
     "eq",
     "angle(A,B,C)",
     "angle(A,C,B)"
    ],
    [
     "eq",
     "angle(A,B,C)+angle(B,C,A)+angle(C,A,B)",
     "pi"
    ]
   ],
   "beats": [
    {
     "say": "Two sides of this triangle are equal.",
     "do": [
      [
       "show",
       "tri",
       "A",
       "B",
       "C"
      ]
     ]
    },
    {
     "say": "Fold it along the line from the top to the middle of the base.",
     "do": [
      [
       "show",
       "AM",
       "angM"
      ],
      [
       "highlight",
       "AM"
      ]
     ]
    },
    {
     "say": "The two halves match, so the base angles are equal.",
     "do": [
      [
       "show",
       "angB",
       "angC",
       "ro"
      ]
     ]
    },
    {
     "say": "Change the top angle and they stay equal.",
     "do": [
      [
       "animate",
       "apex",
       "80*deg",
       {
        "run": 3
       }
      ],
      [
       "animate",
       "apex",
       "40*deg",
       {
        "run": 2
       }
      ]
     ]
    }
   ]
  }
 },
 {
  "topic": "slope of a straight line y = m x + c",
  "tags": "algebra graph linear function gradient slope intercept axes",
  "ir": {
   "title": "Slope of a line",
   "vars": {
    "m": 0.5,
    "c": 1,
    "x1": 1,
    "x2": 3,
    "y1": "m*x1+c",
    "y2": "m*x2+c"
   },
   "objects": [
    {
     "type": "axes",
     "id": "ax",
     "x": [
      -1,
      5
     ],
     "y": [
      -1,
      5
     ],
     "unit": [
      0.9,
      0.9
     ],
     "x_label": "x",
     "y_label": "y"
    },
    {
     "type": "function",
     "id": "line",
     "on": "ax",
     "expr": "m*x+c",
     "color": "a",
     "tex_label": "y = mx + c"
    },
    {
     "type": "point",
     "id": "P",
     "on": "ax",
     "at": [
      "x1",
      "y1"
     ],
     "color": "b"
    },
    {
     "type": "point",
     "id": "Q",
     "on": "ax",
     "at": [
      "x2",
      "y2"
     ],
     "color": "b"
    },
    {
     "type": "point",
     "id": "K",
     "on": "ax",
     "at": [
      "x2",
      "y1"
     ]
    },
    {
     "type": "segment",
     "id": "run",
     "from": "P",
     "to": "K",
     "color": "muted",
     "dashed": true,
     "label": "run 2"
    },
    {
     "type": "segment",
     "id": "rise",
     "from": "K",
     "to": "Q",
     "color": "b",
     "label": "rise {y2-y1:.1f}"
    },
    {
     "type": "readout",
     "id": "ro",
     "text": "slope m = rise / run = {(y2-y1)/(x2-x1):.2f}"
    }
   ],
   "checks": [
    [
     "eq",
     "(y2-y1)/(x2-x1)",
     "m"
    ]
   ],
   "beats": [
    {
     "say": "Here is the line y equals m x plus c.",
     "do": [
      [
       "show",
       "ax",
       "line"
      ]
     ]
    },
    {
     "say": "Step two to the right along the line, and see how far it rises.",
     "do": [
      [
       "show",
       "P",
       "Q",
       "run",
       "rise"
      ],
      [
       "show",
       "ro"
      ]
     ]
    },
    {
     "say": "Rise over run is the slope; make the line steeper and it grows.",
     "do": [
      [
       "animate",
       "m",
       1.5,
       {
        "run": 3
       }
      ]
     ]
    }
   ]
  }
 },
 {
  "topic": "area of a parallelogram by cutting off a right triangle and sliding it to make a rectangle (dissection / rearrangement proof)",
