    "E1": "E0*eff",
    "E2": "E1*eff",
    "E3": "E2*eff"
   },
   "objects": [
    {
     "type": "icon",
     "id": "sun",
     "icon": "sun",
     "size": 1.1
    },
    {
     "type": "box",
     "id": "grass",
     "text": "Grass",
     "color": "good"
    },
    {
     "type": "box",
     "id": "rabbit",
     "text": "Rabbit",
     "color": "b"
    },
    {
     "type": "box",
     "id": "fox",
     "text": "Fox",
     "color": "d"
    },
    {
     "type": "flow",
     "id": "f0",
     "from": "sun",
     "to": "grass",
     "color": "accent"
    },
    {
     "type": "flow",
     "id": "f1",
     "from": "grass",
     "to": "rabbit",
     "label": "10%"
    },
    {
     "type": "flow",
     "id": "f2",
     "from": "rabbit",
     "to": "fox",
     "label": "10%"
    },
    {
     "type": "label",
     "id": "lg",
     "for": "grass",
     "text": "{E1:.0f} kJ",
     "side": "below",
     "color": "muted"
    },
    {
     "type": "label",
     "id": "lr",
     "for": "rabbit",
     "text": "{E2:.0f} kJ",
     "side": "below",
     "color": "muted"
    },
    {
     "type": "label",
     "id": "lf",
     "for": "fox",
     "text": "{E3:.0f} kJ",
     "side": "below",
     "color": "muted"
    }
   ],
   "constraints": [
    [
     "row",
     [
      "sun",
      "grass",
      "rabbit",
      "fox"
     ],
     1.3
    ]
   ],
   "checks": [
    [
     "eq",
     "E3",
     "E0*eff**3"
    ]
   ],
   "beats": [
