 {
  "topic": "the derivative as the slope of the tangent line: a secant through two points of a curve slides until it becomes the tangent",
  "tags": "calculus derivative tangent secant slope limit curve function graph rate change",
  "ir": {
   "title": "Derivative: secant to tangent",
   "vars": {
    "x0": 1,
    "h": 2,
    "x1": "x0+h",
    "y0": "x0**2",
    "y1": "x1**2",
    "m": "(y1-y0)/(x1-x0)",
    "k": "2*x0"
   },
   "objects": [
    {
     "type": "axes",
     "id": "ax",
     "x": [
      -1,
      4
     ],
     "y": [
      -1,
      10
     ],
     "size": [
      5.5,
      4.6
     ],
     "x_label": "x",
     "y_label": "y"
    },
    {
     "type": "function",
     "id": "f",
     "on": "ax",
     "expr": "x**2",
     "color": "ink",
     "tex_label": "y = x^2"
    },
    {
     "type": "point",
     "id": "P",
     "on": "ax",
     "at": [
      "x0",
      "y0"
     ],
     "color": "accent",
     "label": "P"
    },
    {
     "type": "point",
     "id": "Q",
     "on": "ax",
     "at": [
      "x1",
      "y1"
     ],
     "color": "b",
     "label": "Q"
    },
    {
     "type": "line",
     "id": "sec",
     "from": "P",
     "to": "Q",
     "color": "b",
     "label": "secant"
    },
    {
     "type": "point",
     "id": "T",
     "on": "ax",
     "at": [
      "x0+1",
      "y0+k"
     ]
    },
    {
     "type": "line",
     "id": "tan",
     "from": "P",
     "to": "T",
     "color": "highlight",
     "label": "tangent"
    },
    {
     "type": "readout",
     "id": "ro",
     "text": "secant slope = {m:.2f}"
    },
    {
     "type": "readout",
     "id": "ro2",
     "text": "tangent slope = {k:.0f}"
    }
   ],
   "constraints": [],
   "checks": [
    [
     "eq",
     "deriv(f, x0)",
     "k"
    ],
    [
     "gt",
     "m",
     "k"
    ]
   ],
   "beats": [
    {
     "say": "Here is the curve y equals x squared, with a point P at x equals 1.",
     "do": [
      [
       "show",
       "ax",
       "f",
       "P"
      ]
     ]
    },
    {
     "say": "A secant through P and a second point Q has slope rise over run: here 4.",
     "do": [
      [
       "show",
       "Q",
       "sec",
       "ro"
      ]
     ]
    },
    {
     "say": "Slide Q toward P, and the secant's slope falls toward 2.",
     "do": [
      [
       "animate",
       "h",
       0.05,
       {
        "run": 3,
        "rate": "smooth"
       }
      ]
     ]
    },
    {
     "say": "In the limit the secant becomes the tangent at P: its slope, 2, is the derivative there.",
     "do": [
      [
       "hide",
       "sec",
       "Q",
       "ro"
      ],
      [
       "show",
       "tan",
       "ro2"
      ],
      [
       "highlight",
       "tan"
      ]
     ]
    }
   ]
  },
  "score": null,
  "added": "2026-10-09"
 },
 {
  "topic": "projectile motion: a ball launched at an angle follows a parabola; horizontal velocity constant, vertical velocity shrinks to zero at the top then grows downward",
  "tags": "physics projectile motion launch velocity components gravity trajectory parabola ball kinematics",
  "ir": {
   "title": "Projectile motion",
   "vars": {
    "v0": 20,
    "theta": "45*deg",
    "g": 9.8,
    "vx": "v0*cos(theta)",
    "vy0": "v0*sin(theta)",
    "T": "2*vy0/g",
    "t": 0,
    "vy": "vy0 - g*t"
   },
   "objects": [
    {
     "type": "axes",
     "id": "ax",
     "x": [
      0,
      45
     ],
     "y": [
      0,
      12
     ],
     "size": [
      7.5,
      3.6
     ],
     "x_label": "x (m)",
     "y_label": "y (m)"
    },
    {
     "type": "curve",
     "id": "path",
     "on": "ax",
     "x": "vx*u",
     "y": "vy0*u - g*u**2/2",
