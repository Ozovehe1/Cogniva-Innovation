[
 {
  "topic": "adding up the numbers in an array with a loop",
  "tags": "algorithm array loop index pointer running total programming",
  "ir": {
   "title": "Summing an array",
   "vars": {
    "i": 0,
    "total": 0
   },
   "objects": [
    {
     "type": "cells",
     "id": "arr",
     "values": [
      4,
      7,
      1,
      8,
      3
     ]
    },
    {
     "type": "pointer",
     "id": "ptr",
     "at": "arr[{i}]",
     "text": "i = {i}"
    },
    {
     "type": "readout",
     "id": "ro",
     "text": "total = {total}"
    }
   ],
   "checks": [
    [
     "eq",
     "4+7+1+8+3",
     "23"
    ]
   ],
   "beats": [
    {
     "say": "Start with a total of zero at the first cell.",
     "do": [
      [
       "show",
       "arr",
       "ptr",
       "ro"
      ]
     ]
    },
    {
     "say": "Add the cell, then move one to the right.",
     "do": [
      [
       "highlight",
       "arr[0]"
      ],
      [
       "set",
       {
        "total": "total+4"
       }
      ],
      [
       "set",
       {
        "i": "i+1"
       }
      ],
      [
       "highlight",
       "arr[1]"
      ],
      [
       "set",
       {
        "total": "total+7"
       }
      ],
      [
       "set",
       {
        "i": "i+1"
       }
      ]
     ]
    },
    {
     "say": "Keep going to the end.",
     "do": [
      [
       "set",
       {
        "total": "total+1",
        "i": "i+1"
       }
      ],
      [
       "set",
       {
        "total": "total+8",
        "i": "i+1"
       }
      ],
      [
       "set",
       {
        "total": "total+3"
       }
      ],
      [
       "color",
       "arr[0:5]",
       "good"
      ]
     ]
    },
    {
     "say": "The total is twenty three.",
     "do": [
      [
       "highlight",
       "ro"
      ]
     ]
    }
   ]
  }
 },
 {
  "topic": "energy flow in a food chain",
  "tags": "biology ecology process flow diagram energy chain sequence",
