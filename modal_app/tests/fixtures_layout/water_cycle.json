 ],
 "constraints": [
  [
   "left_of",
   "sea",
   "mountain",
   3.0
  ],
  [
   "below",
   "sun",
   "cloud",
   1.5
  ],
  [
   "left_of",
   "sun",
   "mountain",
   1.0
  ],
  [
   "above",
   "cloud",
   "sea",
   2.0
  ]
 ],
 "checks": [
  [
   "true",
   "stage >= 0"
  ]
 ],
 "beats": [
  {
   "say": "The sun heats the sea, causing water to evaporate.",
   "do": [
    [
     "show",
     "sun",
     "sea"
    ],
    [
     "show",
     "f_evap"
    ],
    [
     "flow",
     "f_evap",
     {
      "color": "accent"
     }
    ]
   ]
  },
  {
   "say": "Rising water vapour cools and condenses into clouds.",
