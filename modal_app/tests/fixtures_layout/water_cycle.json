   "do": [
    [
     "show",
     "mountain"
    ],
    [
     "show",
     "f_precip"
    ],
    [
     "flow",
     "f_precip",
     {
      "color": "water"
     }
    ]
   ]
  },
  {
   "say": "Water flows downhill as runoff, returning to the sea.",
   "do": [
    [
     "show",
     "f_runoff"
    ],
    [
     "flow",
     "f_runoff",
     {
      "color": "water"
     }
    ],
    [
     "set",
     {
      "stage": 1
     }
    ]
   ]
  }
 ]
