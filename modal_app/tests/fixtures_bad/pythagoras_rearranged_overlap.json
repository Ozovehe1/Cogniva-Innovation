{"title": "Pythagoras by rearrangement",
 "vars": {"a": 1.9, "b": 1.2, "s": "a+b", "c": "sqrt(a**2+b**2)"},
 "objects": [
  {"type": "point", "id": "S0", "at": [0, 0]}, {"type": "point", "id": "S1"}, {"type": "point", "id": "S2"}, {"type": "point", "id": "S3"},
  {"type": "point", "id": "E"}, {"type": "point", "id": "F"}, {"type": "point", "id": "G"}, {"type": "point", "id": "H"},
  {"type": "point", "id": "M"}, {"type": "point", "id": "Ab"}, {"type": "point", "id": "As"}, {"type": "point", "id": "Ar"}, {"type": "point", "id": "Al"},
  {"type": "polygon", "id": "big_sq", "points": ["S0", "S1", "S2", "S3"], "color": "ink", "fill": 0},
  {"type": "polygon", "id": "rt1", "points": ["S0", "E", "H"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "rt2", "points": ["S1", "F", "E"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "rt3", "points": ["S2", "G", "F"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "rt4", "points": ["S3", "H", "G"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "sq_c", "points": ["E", "F", "G", "H"], "color": "highlight", "fill": 0.35},
  {"type": "polygon", "id": "rt1b", "points": ["M", "Ab", "Ar"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "rt3b", "points": ["As", "Al", "M"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "rt4b", "points": ["Al", "M", "S3"], "color": "a", "fill": 0.5},
  {"type": "polygon", "id": "sq_a", "points": ["S0", "Ab", "M", "Al"], "color": "b", "fill": 0.35},
  {"type": "polygon", "id": "sq_b", "points": ["M", "Ar", "S2", "As"], "color": "c", "fill": 0.35},
  {"type": "label", "id": "la", "for": "S0-E", "text": "a", "side": "below"},
  {"type": "label", "id": "lb", "for": "S0-H", "text": "b", "side": "left"},
  {"type": "label", "id": "lc", "for": "sq_c", "tex": "c^2"},
  {"type": "label", "id": "la2", "for": "sq_a", "tex": "a^2"},
  {"type": "label", "id": "lb2", "for": "sq_b", "tex": "b^2"},
  {"type": "equation", "id": "eq", "lines": [{"sym": "a**2 + b**2 = c**2", "note": "same square, same four triangles"}]}],
 "constraints": [
  ["offset", "S1", "S0", "s", 0], ["offset", "S2", "S0", "s", "s"], ["offset", "S3", "S0", 0, "s"],
  ["offset", "E", "S0", "a", 0], ["offset", "F", "S0", "s", "a"], ["offset", "G", "S0", "b", "s"], ["offset", "H", "S0", 0, "b"],
  ["offset", "M", "S0", "a", "a"], ["offset", "Ab", "S0", "a", 0], ["offset", "Ar", "S0", "s", "a"], ["offset", "As", "S0", "a", "s"], ["offset", "Al", "S0", 0, "a"]],
 "checks": [["eq", "area(sq_c)", "area(sq_a) + area(sq_b)"], ["eq", "area(rt1)", "area(rt1b)"], ["eq", "length(E,H)", "c"]],
 "beats": [
  {"say": "Four copies of a right triangle with legs a and b fill the corners of a square of side a plus b.", "do": [["show", "big_sq", "rt1", "rt2", "rt3", "rt4", "la", "lb"]]},
  {"say": "The space they leave is a tilted square with side c, so its area is c squared.", "do": [["show", "sq_c", "lc"], ["highlight", "sq_c"]]},
  {"say": "Now slide three of the triangles so they pair up into two rectangles.", "do": [["hide", "sq_c", "lc", "la", "lb"], ["morph", ["rt1", "rt3", "rt4"], ["rt1b", "rt3b", "rt4b"]]]},
  {"say": "The space left is now two squares, a squared and b squared.", "do": [["show", "sq_a", "sq_b", "la2", "lb2"]]},
  {"say": "Same big square, same four triangles, so a squared plus b squared equals c squared.", "do": [["show", "eq"], ["equation", "eq", 0]]}]}
